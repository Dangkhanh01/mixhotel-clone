  "title": "ContactModalInteractionContract",
  "description": "Hợp đồng kỹ thuật khóa cứng cấu trúc, ID, data attributes và events cho Contact Modal (#popupContact_1)",
  "version": "1.0.0",

  "modal": {
    "id": "popupContact_1",
    "wrapperClass": "mix-contact-modal",
    "activeClass": "is-active",
    "bodyLockClass": "modal-open",
    "overlaySelector": ".mix-contact-modal__overlay",
    "contentSelector": ".mix-contact-modal__content",
    "closeSelector": ".mix-contact-modal__close",
    "zIndex": {
      "overlay": 1000,
      "content": 1050
    }
  },

  "triggerAttributes": {
    "action": "data-contact-action",
    "branchId": "data-branch-id",
    "roomTitle": "data-room-title"
  },

  "supportedContactTypes": ["phone", "zalo", "messenger", "sms", "booking"],

